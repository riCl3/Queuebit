# Queuebit environment configuration
# Copy this file to .env and fill in your values.

# --- Server ---
PORT=3000

# --- Databases (local Docker default) ---
MONGO_URI=mongodb://localhost:27017/queuebit
REDIS_URI=redis://localhost:6379

# --- AI provider (OpenAI-compatible) ---
# Default provider is Groq (free tier). Get a key at https://console.groq.com
# For xAI Grok instead, set:
#   AI_API_KEY=xai-...
#   AI_BASE_URL=https://api.x.ai/v1
#   AI_MODEL=grok-3
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# --- Real-time events ---
# Base URL of the Queuebit API server that the worker emits job updates to.
SOCKET_SERVER_URL=http://localhost:3000
